FROM node:22-alpine
WORKDIR /app
# Dependencies are installed by the compose command so a package.json change
# doesn't require a rebuild. This image only provides Node.
#
# Run as the image's non-root `node` user (uid 1000). On Linux/WSL hosts the
# bind mount otherwise leaves root-owned files (lockfile, generated migrations,
# .next) that the host user cannot edit. The two directories are pre-created so
# the named volumes mounted there inherit `node` ownership.
RUN mkdir -p /app/node_modules /app/public/uploads && chown -R node:node /app
USER node
EXPOSE 3000
