# Copy to .env.local for running outside Docker. Compose sets all of these itself.

# Postgres connection string. Locally set by Compose; on Vercel injected by the Neon integration.
DATABASE_URL=postgres://kad:kad@localhost:5432/kad_tunang

# Single admin password, compared in constant time.
ADMIN_PASSWORD=admin

# HMAC key for the admin session cookie. Rotating it logs the admin out. Generate with: openssl rand -hex 32
ADMIN_SECRET=dev-secret-change-in-prod

# `local` writes uploads to public/uploads; `vercel-blob` uses Vercel Blob.
# Default when unset: `vercel-blob` if BLOB_READ_WRITE_TOKEN is present, else `local`.
STORAGE_DRIVER=local

# Injected by the Vercel Blob integration. Not needed locally.
# BLOB_READ_WRITE_TOKEN=

# Absolute URL of the site, used for Open Graph metadata and local upload URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
